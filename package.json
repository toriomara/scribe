{
  "name": "scribe",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram userbot: transcribes voice notes from Saved Messages and sends them as text on your behalf",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "login": "tsx --env-file=.env src/login.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "openai": "^7.53.0",
    "telegram": "^2.26.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
